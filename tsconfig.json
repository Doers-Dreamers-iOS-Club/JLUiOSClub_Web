{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "vitepress/dist/client/theme-default/components/VPSidebarGroup.vue": [
        "./.vitepress/types/vitepress-sidebar-group.d.ts"
      ],
      "vitepress/dist/client/theme-default/components/VPMenu.vue": [
        "./.vitepress/types/vitepress-menu.d.ts"
      ]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.mts",
    ".vitepress/**/*.vue",
    "docs/components/**/*.vue"
  ],
  "exclude": [
    ".vitepress/cache",
    ".vitepress/dist"
  ]
}
